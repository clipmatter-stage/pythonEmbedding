# Copy to .env and load it in your shell/deployment. Never commit credentials.
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
# Configure the SAME nonempty key in both Railway API and RQ worker services.
# It must match Laravel EMBEDDING_API_KEY; needed for API auth and legacy callbacks.
API_KEY=your-client-api-key
OPENAI_API_KEY=your-openai-api-key

# Focused intent parsing, translation, and ingestion summaries.
OPENAI_TEXT_MODEL=gpt-6-luna
# Fast search: one cached embedding plus one Qdrant query; no generative calls.
SEARCH_PIPELINE=fast
SEARCH_LLM_UNDERSTANDING=false
SEARCH_RERANKING=false
SEARCH_VALIDATE_RESULTS=false
FAST_SEARCH_CANDIDATE_LIMIT=100
SEARCH_QDRANT_TIMEOUT=8
# Shared cursor cache timeout; on write failure return the full bounded snapshot.
SEARCH_CACHE_TIMEOUT_SECONDS=3
# Dense branch cosine floor, separate from optional verified relevance min_score.
SEARCH_MIN_DENSE_SCORE=0
# Used only by SEARCH_PIPELINE=verified (the previous, slower pipeline).
USE_LLM_UNDERSTANDING=true
# Optional indexed transcript contract optimization. Coverage is checked before use.
TRANSCRIPT_CONTRACT_INDEX_V1=false
USE_OPENAI_EMBEDDINGS=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
SEGMENTS_COLLECTION=video_transcript_segments

# Optional native Qdrant MaxSim, used when SEARCH_RERANKING=true or verified.
# BGE-M3 weights run locally; token vectors are cached separately from dense data.
QDRANT_RERANK_COLLECTION=video_transcript_rerank_bge_m3_v1
QDRANT_RERANK_MODEL=BAAI/bge-m3
QDRANT_RERANK_DIMENSION=1024
QDRANT_RERANK_DEVICE=cpu
# Optional CPU threads; automatically capped to the container CPU quota.
QDRANT_RERANK_CPU_THREADS=8
QDRANT_RERANK_BATCH_SIZE=4
QDRANT_RERANK_MAX_TOKENS=1024
SEMANTIC_CANDIDATE_LIMIT=60
# Verify only the best native-ranked passages; raise up to 60 for deeper coverage.
SEARCH_VALIDATION_CANDIDATE_LIMIT=20
SEARCH_CONTEXT_SECONDS=20
# Optional MEAN MaxSim floor; calibrate with labeled queries, not a probability.
# QDRANT_RERANK_MIN_SCORE=

ENSURE_INDEXES_ON_STARTUP=true
PORT=9000
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CORS_ORIGINS=*
# API and worker must use the SAME Railway Redis connection.
# localhost is only a local-development example.
REDIS_URL=redis://localhost:6379
# Optional probe-destination allowlist; this is the code default, not a new requirement.
CALLBACK_ALLOWED_HOSTS=clip.digitalmatters.pk
